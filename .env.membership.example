# Netlify / Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Required by the app's direct phone-login fallback.
SUPABASE_ANON_KEY=replace-me

# AI insight generation
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-luna
WAITLIST_EXTRACTION_MODEL=gpt-5.6-luna
WAITLIST_CONVERSATION_MODEL=gpt-5.6-sol
WAITLIST_CONVERSATION_POLISH=true
# Migration 015 must be applied before serving the semantic conversation release.
# Production defaults to required; legacy is only an explicit diagnostic escape hatch.
BM_SEMANTIC_PERSISTENCE=required

# Shopify webhooks
SHOPIFY_WEBHOOK_SECRET=replace-me
SHOPIFY_WEBHOOK_TOKEN=replace-me-if-hmac-secret-is-not-available
SHOPIFY_TRIAL_VARIANT_IDS=trial-variant-id-or-sku
SHOPIFY_MONTHLY_VARIANT_IDS=monthly-variant-id-or-sku
SHOPIFY_ANNUAL_VARIANT_IDS=annual-variant-id-or-sku
SHOPIFY_FAMILY_VARIANT_IDS=family-variant-id-or-sku
SHOPIFY_TRIAL_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965231447,691965231447
SHOPIFY_MONTHLY_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965264215,691965264215
SHOPIFY_ANNUAL_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965690199,691965690199
SHOPIFY_FAMILY_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965722967,691965722967

# Admin automation endpoints
MEMBERSHIP_ADMIN_SECRET=replace-me
PUBLIC_ACTIVATION_LOOKUP_ENABLED=false

# Email delivery
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=Blank <hola@blankeate.com>
RESEND_REPLY_TO_EMAIL=infoblankeate@gmail.com

# iOS build setting
BLANK_MEMBERSHIP_API_BASE_URL=https://your-site.netlify.app/.netlify/functions
BLANK_WHATSAPP_PHONE_NUMBER=13478366767
BLANK_SMS_PHONE_NUMBER=+13478366767

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-token
WHATSAPP_ACCESS_TOKEN=meta-permanent-or-system-user-token
WHATSAPP_PHONE_NUMBER_ID=meta-phone-number-id
WHATSAPP_APP_SECRET=meta-app-secret
WHATSAPP_GRAPH_API_VERSION=v26.0
BLANKED_APP_DEEP_LINK_SCHEME=blank
BLANKED_PUBLIC_APP_LINK_BASE=https://getblank.netlify.app
BLANKMIND_APP_DOWNLOAD_URL=https://apps.apple.com/es/app/id6789519152

# APNs background execution for confirmed WhatsApp/SMS actions
APNS_TEAM_ID=GS54UV79RG
APNS_KEY_ID=replace-with-apple-key-id
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----"
APNS_TOPIC=com.blanknfc.app.ios

# SMS provider webhook
# Point the provider inbound SMS webhook to:
# https://your-site.netlify.app/.netlify/functions/sms-agent
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+13478366767
TWILIO_WHATSAPP_FROM_NUMBER=+13478366767
# Optional alternative to TWILIO_FROM_NUMBER:
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional WhatsApp CTA button template for action links.
# Create a Twilio Content Template with one URL variable pointing to {{1}}.
TWILIO_WHATSAPP_REVIEW_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set true only after verifying the template button label is exactly "Review and confirm".
TWILIO_WHATSAPP_REVIEW_TEMPLATE_ENABLED=false
TWILIO_WHATSAPP_ACTION_CONTENT_VARIABLES={"1":"{{link}}"}

# Temporary Blankmind Early Access flow.
# `twilio` uses Content SIDs. `meta` uses approved WhatsApp template names.
WAITLIST_WHATSAPP_PROVIDER=twilio
BM_FINAL_QA_WHATSAPP_PHONE=
WAITLIST_WHATSAPP_OPENING_CONTENT_SID_1=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WAITLIST_WHATSAPP_OPENING_CONTENT_SID_2=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WAITLIST_WHATSAPP_OPENING_TEMPLATE_1=blankmind_early_access_welcome_1
WAITLIST_WHATSAPP_OPENING_TEMPLATE_2=blankmind_early_access_welcome_2
WAITLIST_WHATSAPP_TEMPLATE_LANGUAGE=en
WAITLIST_TWILIO_WEBHOOK_URL=https://your-site.netlify.app/.netlify/functions/waitlist-agent
WAITLIST_PUBLIC_URL=https://blankmind.ai/early-access
# Diagnostic only. Never enable this on production because business-initiated WhatsApp messages require approved templates.
WAITLIST_ALLOW_FREEFORM_OPENING=false

# Voice replies and phone calls are disabled. Audio inputs are transcribed and answered with text.

# Direct wearable APIs
WEARABLE_OAUTH_REDIRECT_BASE=https://your-site.netlify.app
WEARABLE_OAUTH_STATE_SECRET=replace-me-long-random-secret
WEARABLE_TOKEN_ENCRYPTION_KEY=replace-me-long-random-secret
WEARABLE_SYNC_ADMIN_SECRET=replace-me-or-use-membership-admin-secret
OURA_CLIENT_ID=replace-me
OURA_CLIENT_SECRET=replace-me
# Optional, only if the provider gives Blankmind a revocation endpoint.
OURA_REVOKE_URL=
WHOOP_CLIENT_ID=replace-me
WHOOP_CLIENT_SECRET=replace-me
# Optional, only if the provider gives Blankmind a revocation endpoint.
WHOOP_REVOKE_URL=
GOOGLE_HEALTH_CLIENT_ID=replace-me
GOOGLE_HEALTH_CLIENT_SECRET=replace-me
WITHINGS_CLIENT_ID=replace-me
WITHINGS_CLIENT_SECRET=replace-me
# Optional, only if the provider gives Blankmind a revocation endpoint.
WITHINGS_REVOKE_URL=
# Garmin requires partner access before OAuth can be completed.
# Jev advisory pilot: server-only secret, disabled unless all synthetic QA gates match.
TYPESAFE_API_KEY=
BM_JEV_SHADOW_ENABLED=false
## Bounded Decisions retrieval: default OFF. Global activation requires release gates.
## Account-records mode accepts only the known production or isolated QA Supabase.
BM_RETRIEVAL_STEP_ENABLED=false
BM_DECISIONS_DATA_POLICY=
## Legacy synthetic QA experiment; leave OFF for global account-records mode.
BM_RETRIEVAL_STEP_QA_ENABLED=false
BM_DECISIONS_QA_ENABLED=false
BM_DECISIONS_QA_USERS=
BM_JEV_PREFETCH_EXPERIMENT=false
BM_JEV_DATA_POLICY=
BM_JEV_QA_USERS=
BM_JEV_QA_SINCE=
BM_JEV_QA_PERCENT=0
# App voice output. Disabled until migration 031 and private QA verification.
BM_VOICE_ENABLED=false
