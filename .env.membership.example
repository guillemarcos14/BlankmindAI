# Netlify / Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Required by the app's direct phone-login fallback.
SUPABASE_ANON_KEY=replace-me

# AI insight generation
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-luna
WAITLIST_EXTRACTION_MODEL=gpt-5.6-luna
WAITLIST_CONVERSATION_MODEL=gpt-5.6-sol
WAITLIST_CONVERSATION_POLISH=true
# Migration 015 must be applied before serving the semantic conversation release.
# Production defaults to required; legacy is only an explicit diagnostic escape hatch.
BM_SEMANTIC_PERSISTENCE=required

# Shopify webhooks
SHOPIFY_WEBHOOK_SECRET=replace-me
SHOPIFY_WEBHOOK_TOKEN=replace-me-if-hmac-secret-is-not-available
SHOPIFY_TRIAL_VARIANT_IDS=trial-variant-id-or-sku
SHOPIFY_MONTHLY_VARIANT_IDS=monthly-variant-id-or-sku
SHOPIFY_ANNUAL_VARIANT_IDS=annual-variant-id-or-sku
SHOPIFY_FAMILY_VARIANT_IDS=family-variant-id-or-sku
SHOPIFY_TRIAL_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965231447,691965231447
SHOPIFY_MONTHLY_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965264215,691965264215
SHOPIFY_ANNUAL_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965690199,691965690199
SHOPIFY_FAMILY_SELLING_PLAN_IDS=gid://shopify/SellingPlan/691965722967,691965722967

# Admin automation endpoints
MEMBERSHIP_ADMIN_SECRET=replace-me
PUBLIC_ACTIVATION_LOOKUP_ENABLED=false

# Email delivery
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=Blank <hola@blankeate.com>
RESEND_REPLY_TO_EMAIL=infoblankeate@gmail.com

# iOS build setting
BLANK_MEMBERSHIP_API_BASE_URL=https://your-site.netlify.app/.netlify/functions
# APNs for measured-rest actions and follow-ups
APNS_TEAM_ID=GS54UV79RG
APNS_KEY_ID=replace-with-apple-key-id
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----"
APNS_TOPIC=com.blanknfc.app.ios


# Blankmind is app-only. Voice uses the authenticated app endpoints.

# CORE optimizations. Production activation still requires measured evidence.
BM_RETRIEVAL_STEP_ENABLED=false
BM_DECISIONS_DATA_POLICY=
BM_RETRIEVAL_STEP_QA_ENABLED=false
BM_DECISIONS_QA_ENABLED=false
BM_DECISIONS_QA_USERS=
BM_AGENT_ENABLED=false
BM_AGENT_QA_ENABLED=false
BM_AGENT_QA_FEATURES=tools,retrieval,labels
BM_AGENT_LABEL_DAILY_USD=

# App voice: separate consent and authenticated leased turns.
BM_VOICE_ENABLED=false
BM_VOICE_PROVIDER=elevenlabs
BM_VOICE_ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY=
