<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleDisplayName</key>
	<string>Blankmind</string>
	<key>BlankMembershipAPIBaseURL</key>
	<string>$(BLANK_MEMBERSHIP_API_BASE_URL)</string>
	<key>BlankPrivateQAAuthenticationCookie</key>
	<string>$(BLANK_PRIVATE_QA_COOKIE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>Blankmind</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.blanknfc.app.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>blank</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NFCReaderUsageDescription</key>
	<string>Blankmind may use NFC for legacy tag backup flows when enabled.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Blankmind reads health data you choose to share, including sleep, physical signals, activity, daylight, nutrition, reproductive health, symptoms and wellbeing, to put your rest and disconnection habits in context. Progress analysis stays on your device. It does not diagnose medical conditions.</string>
	<key>NSHealthClinicalHealthRecordsShareUsageDescription</key>
	<string>Blankmind reads the clinical records you choose to share to show available health context alongside your rest patterns. Clinical documents remain on your device and in Apple Health; Progress does not send them to AI or diagnose conditions.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Blankmind does not write data to Apple Health.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Blankmind uses Face ID or your device passcode to protect advanced blocking settings when you enable PIN protection.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Blankmind uses the microphone so you can dictate messages to BM.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Blankmind uses speech recognition to turn your dictated messages into text for BM.</string>
	<key>UIAppFonts</key>
	<array>
		<string>instrument_serif_regular.ttf</string>
		<string>inter_variable.ttf</string>
		<string>neue-montreal-regular.otf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
